<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:visibility="gone"
        android:id="@+id/btnLogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginRight="5dp"
        android:text="Logs"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_twin"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp"
                android:layout_marginLeft="40dp"
                android:background="@drawable/twin"
                android:layout_width="230dp"
                android:layout_gravity="center_horizontal"
                android:layout_height="150dp"/>

            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test done!"
                android:textSize="33dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_id"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESULTS"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date &amp; Time"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_date"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="21dp"
                android:textColor="@color/black"/>

            <TextView
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCREENING LEVEL"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_screening"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="21dp"
                android:textColor="@color/black"/>

            <TextView
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEST LOCATION"
                android:textSize="18dp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_location"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="21dp"
                android:textColor="@color/black"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">

                <RelativeLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv1"
                        android:layout_marginLeft="30dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEFT"
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view50"
                        android:layout_below="@+id/tv1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_below="@+id/view50"
                        android:layout_marginLeft="30dp"
                        android:id="@+id/tv500leftNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view1"
                        android:layout_below="@+id/tv500leftNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_below="@+id/view1"
                        android:layout_marginLeft="30dp"
                        android:id="@+id/tv500left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view51"
                        android:layout_below="@+id/tv500left"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view51"
                        android:id="@+id/tv1000leftNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view11"
                        android:layout_below="@+id/tv1000leftNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view11"
                        android:id="@+id/tv1000left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view52"
                        android:layout_below="@+id/tv1000left"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view52"
                        android:id="@+id/tv2000leftNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view12"
                        android:layout_below="@+id/tv2000leftNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view12"
                        android:id="@+id/tv2000left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view53"
                        android:layout_below="@+id/tv2000left"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view53"
                        android:id="@+id/tv4000leftNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view13"
                        android:layout_below="@+id/tv4000leftNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_marginLeft="30dp"
                        android:layout_below="@+id/view13"
                        android:id="@+id/tv4000left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_alignParentRight="true"
                        android:id="@+id/tv2"
                        android:layout_marginRight="30dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RIGHT"
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view54"
                        android:layout_below="@+id/tv2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_below="@+id/view54"
                        android:layout_marginRight="30dp"
                        android:id="@+id/tv500rightNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view2"
                        android:layout_below="@+id/tv500rightNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_below="@+id/view2"
                        android:layout_marginRight="30dp"
                        android:id="@+id/tv500right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view55"
                        android:layout_below="@+id/tv500right"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view55"
                        android:id="@+id/tv1000rightNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view21"
                        android:layout_below="@+id/tv1000rightNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view21"
                        android:id="@+id/tv1000right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view56"
                        android:layout_below="@+id/tv1000right"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view56"
                        android:id="@+id/tv2000rightNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view22"
                        android:layout_below="@+id/tv2000rightNoise"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view22"
                        android:id="@+id/tv2000right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view57"
                        android:layout_below="@+id/tv2000right"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view57"
                        android:id="@+id/tv4000rightNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <View
                        android:id="@+id/view23"
                        android:layout_below="@+id/tv2000right"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"/>

                    <TextView
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:layout_below="@+id/view23"
                        android:id="@+id/tv4000right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:weightSum="2"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ll_whatsapp"
                    android:padding="5dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:background="@drawable/et_grey"
                    android:gravity="center_horizontal"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:background="@drawable/whatsapp_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:id="@+id/tv_repeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Whatsapp"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_email"
                    android:padding="5dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:background="@drawable/et_grey"
                    android:gravity="center_horizontal"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:background="@drawable/email_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"/>

                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:id="@+id/tv_proceed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:layout_centerHorizontal="true"
                        android:textColor="@color/black"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_home"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/dark_grey"
                android:orientation="horizontal">

                <TextView
                    android:layout_marginRight="50dp"
                    android:layout_marginLeft="50dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="25dp"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>